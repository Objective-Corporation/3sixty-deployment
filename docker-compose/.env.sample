# =============================================================================
# 3Sixty Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# IMPORTANT: Never commit .env to version control
#
# Quick setup:
#   1. cp .env.sample .env        (Linux/macOS)
#      copy .env.sample .env      (Windows)
#   2. Update all CHANGEME values below
#   3. Configure Azure AD settings (CLIENT_ID, TENANT_ID, CLIENT_SECRET)
#   4. Run: make start
# =============================================================================

# -----------------------------------------------------------------------------
# Global Settings
# -----------------------------------------------------------------------------
TZ=Australia/Sydney
GLOBAL_ORG=objective

# -----------------------------------------------------------------------------
# MongoDB Configuration
# -----------------------------------------------------------------------------
MONGO_INITDB_DATABASE=threesixty
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGEME_STRONG_PASSWORD_HERE

# MongoDB connection string (used by applications)
MONGODB_NAME=${MONGO_INITDB_DATABASE}
MONGODB_USERNAME=${MONGO_INITDB_ROOT_USERNAME}
MONGODB_PASSWORD=${MONGO_INITDB_ROOT_PASSWORD}
MONGODB_URI=mongodb://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@mongo:27017/${MONGODB_NAME}

# -----------------------------------------------------------------------------
# RabbitMQ Configuration
# -----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=CHANGEME_RABBITMQ_PASSWORD
RABBITMQ_QUEUE=scim-queue

# Used by services connecting to RabbitMQ
RABBITMQ_USERNAME=${RABBITMQ_DEFAULT_USER}
RABBITMQ_PASSWORD=${RABBITMQ_DEFAULT_PASS}

# -----------------------------------------------------------------------------
# Azure AD / OAuth2 Configuration
# -----------------------------------------------------------------------------
# Required for Discovery service authentication
# Get these from Azure Portal > App Registrations
CLIENT_ID=CHANGEME_YOUR_AZURE_APP_CLIENT_ID
TENANT_ID=CHANGEME_YOUR_AZURE_TENANT_ID
CLIENT_SECRET=CHANGEME_YOUR_AZURE_APP_SECRET

# OAuth2 configuration
OAUTH2_ENABLED=false

# -----------------------------------------------------------------------------
# OpenSearch Configuration
# -----------------------------------------------------------------------------
# Core service ports/credentials are set directly in docker-compose.yaml.
# These variables are consumed by the RAG services to connect to OpenSearch.
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USE_SSL=false
# Leave blank when DISABLE_SECURITY_PLUGIN=true (default for local dev)
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# -----------------------------------------------------------------------------
# 3Sixty Admin Service
# -----------------------------------------------------------------------------
SSL_ENABLED=false
APP_URI=http://threesixty-admin:8080/3sixty-admin

# -----------------------------------------------------------------------------
# SCIM Server Configuration
# -----------------------------------------------------------------------------
SCIM_TOKEN_URL=http://scim-server:8083/scim/v2/token
SCIM_USERNAME=scim-application-admin
SCIM_PASSWORD=CHANGEME_SCIM_PASSWORD

# gRPC Configuration
GRPC_SERVER_START=true
GRPC_SERVER_SSL=false

# -----------------------------------------------------------------------------
# OI RAG Configuration (objectiveoirag image — currently commented out in compose)
# -----------------------------------------------------------------------------
OIRAG_LOG_LEVEL=INFO
OIRAG_EMBEDDING_MODEL=mxbai-embed-large
OIRAG_OLLAMA_URL=http://ollama:11434

# -----------------------------------------------------------------------------
# 3sixty RAG Service (obj3sixtyrag image)
# -----------------------------------------------------------------------------
# CORS — restrict to your domain in production
CORS_ALLOW_ORIGINS=*

# --- LLM Provider (uncomment one block) ---

# Objective Foundation API (default)
OPENAI_API_BASE=https://api.foundation.objective.com/openai
OPENAI_API_KEY=CHANGEME_YOUR_OBJECTIVE_API_KEY
EMBEDDING_MODEL=objective-terminus-nomic-embed-text
QUESTION_AND_ANSWER_MODEL=InfoIntel.gpt-4.1
EXTRACT_SEARCH_QUERY_MODEL=InfoIntel.gpt-4.1
OPENAI_API_HEADER_X_Objective_Intelligence_Tenant_Id=${GLOBAL_ORG}

# Google Gemini
#OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
#OPENAI_API_KEY=CHANGEME_YOUR_GEMINI_KEY
#EMBEDDING_MODEL=gemini-embedding-001
#QUESTION_AND_ANSWER_MODEL=gemini-2.5-flash
#EXTRACT_SEARCH_QUERY_MODEL=gemini-2.5-flash

# OpenAI
#OPENAI_API_BASE=https://api.openai.com/v1
#OPENAI_API_KEY=CHANGEME_YOUR_OPENAI_KEY
#EMBEDDING_MODEL=text-embedding-3-large
#QUESTION_AND_ANSWER_MODEL=gpt-4o
#EXTRACT_SEARCH_QUERY_MODEL=gpt-4o

# Ollama (local — no API key required)
#OPENAI_API_BASE=http://ollama:11434/v1
#OPENAI_API_KEY=no-key
#EMBEDDING_MODEL=mxbai-embed-large
#QUESTION_AND_ANSWER_MODEL=gemma2:2b
#EXTRACT_SEARCH_QUERY_MODEL=gemma2:2b

# --- Model tuning ---
EXTRACT_SEARCH_QUERY_TEMPERATURE=0.75
QUESTION_AND_ANSWER_TEMPERATURE=0.10

# --- Retrieval tuning ---
TEXT_RETRIEVER_K=3
VECTOR_RETRIEVER_K=3
RANKER_EMBEDDING_WEIGHT=0.5
RANKER_BM25_WEIGHT=0.5
RANKER_TEXT_WEIGHT=0.5
RANKER_VECTOR_WEIGHT=0.5
RAG_CONVERSATION_LIMIT=8000

# --- 3sixty RAG service auth & logging ---
BEARER_TOKEN=CHANGEME_RAG_BEARER_TOKEN
LOG_FILE_PATH=/3sixty-rag-logs/oi-rag.log

# -----------------------------------------------------------------------------
# Remote Agent – 3sixty RAG (objectiveremoteagentoirag image)
# -----------------------------------------------------------------------------
# Create the remote agent in the Admin UI first, then paste the token/name here.
REMOTE_AGENT_TOKEN=CHANGEME_REMOTE_AGENT_TOKEN
# REMOTE_AGENT_NAME is used by the Makefile agent-start check
REMOTE_AGENT_NAME=CHANGEME_REMOTE_AGENT_NAME
# REMOTE_AGENT_AGENT_NAME is read by the remote agent container itself
# REMOTE_AGENT_AGENT_NAME=CHANGEME_REMOTE_AGENT_NAME

REMOTE_AGENT_ENDPOINT=http://threesixty-admin:8080/3sixty-admin
REMOTE_AGENT_SERVER_URL=http://threesixty-admin:8080/3sixty-admin
REMOTE_SERVER_URL=http://threesixty-admin:8080/3sixty-admin

SERVER_PORT=8083

# gRPC connection to the admin service
REMOTE_AGENT_GRPC_SERVER_HOST=threesixty-admin
REMOTE_AGENT_GRPC_SERVER_PORT=50052
REMOTE_AGENT_GRPC_SERVER_POOL_SIZE=10

# gRPC timeouts (milliseconds, except TIMEOUT_CHECK_CONNECTION which is seconds)
TIMEOUT_CONFIGURE_FORM=12000
TIMEOUT_METADATA=3000
TIMEOUT_DOCUMENTS=30000
TIMEOUT_DOCUMENT=6000
TIMEOUT_DELETION=6000
TIMEOUT_WRITE=9999
TIMEOUT_EXTENDED=3000
TIMEOUT_CHECK_CONNECTION=30
TIMEOUT_SEND_QUERY_RESPONSE=3000
TIMEOUT_RUN_API_RESPONSE=3000

# Binary upload
REMOTE_AGENT_BINARY_UPLOAD_CHUNK_SIZE_MB=32
REMOTE_AGENT_BINARY_UPLOAD_CONCURRENT_UPLOADS=3

# Remote agent SSL (independent of core SSL_ENABLED above)
SSL_CA_PASSWORD=CHANGEME_SSL_CA_PASSWORD

# Remote agent log level
LOGGING_LEVEL_COM_OBJECTIVE_THREESIXTY_REMOTEAGENT_SDK=INFO

# -----------------------------------------------------------------------------
# Vault Configuration (Optional - Dev Mode)
# -----------------------------------------------------------------------------
# WARNING: Only for development! Use production mode for real deployments
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root
VAULT_DEV_ROOT_TOKEN_ID=root

# -----------------------------------------------------------------------------
# Monitoring Configuration (Optional)
# -----------------------------------------------------------------------------
PROMETHEUS_RETENTION=15d

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME_GRAFANA_PASSWORD

# -----------------------------------------------------------------------------
# Security Notes
# -----------------------------------------------------------------------------
# 1. Generate strong passwords using: openssl rand -base64 32
# 2. Never use default passwords in production
# 3. Rotate credentials regularly (90 days recommended)
# 4. Use HashiCorp Vault for production secret management
# 5. Enable RBAC for all services
# 6. Use Azure Key Vault for cloud deployments
#
# Password Requirements:
# - Minimum 16 characters
# - Mix of uppercase, lowercase, numbers, symbols
# - No dictionary words
# - Unique per service
# =============================================================================
