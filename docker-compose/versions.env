# =============================================================================
# 3Sixty Image Version Manifest
# =============================================================================
# Edit this file to update image versions — one place, all services.
# Used by Makefile (via -include) and docker-compose.yaml (via ${IMAGE_VAR}).
# =============================================================================

ECR = 782396859527.dkr.ecr.ap-southeast-2.amazonaws.com

# --- Objective ECR images ---
IMAGE_3SIXTY_ADMIN          = $(ECR)/objective3sixty:5.2.2
IMAGE_3SIXTY_DISCOVERY      = $(ECR)/objective3sixtydiscovery:5.2.2
IMAGE_SCIM                  = $(ECR)/objectivescimserver:2.0.0
IMAGE_RAG                   = $(ECR)/obj3sixtyrag:1.2.0
IMAGE_REMOTE_AGENT          = $(ECR)/objectiveremoteagentoirag:1.8.0

# --- Public images ---
IMAGE_NGINX                 = nginx:1.28.0-alpine
IMAGE_MONGO                 = mongo:8.0.11
IMAGE_OPENSEARCH            = opensearchproject/opensearch:2.17.1
IMAGE_OPENSEARCH_DASHBOARDS = opensearchproject/opensearch-dashboards:2.17.1
IMAGE_RABBITMQ              = rabbitmq:4.1-management
IMAGE_OLLAMA                = ollama/ollama:0.17.7
